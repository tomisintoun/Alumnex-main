# Copy to .env.local for development. Production requires PostgreSQL and HTTPS.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Set to true only to populate a new development database with fictional examples.
SEED_DEMO=false
# HTTPS email API (optional until configured; password reset fails closed without it).
BREVO_API_KEY=
EMAIL_FROM=
# Optional Paystack integration for NGN giving; never put this in NEXT_PUBLIC_*.
PAYSTACK_SECRET_KEY=
# Development only; SQLite is never allowed in production.
SQLITE_PATH=.data/alumnex.sqlite
